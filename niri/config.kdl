// ============================================================
// Niri 窗口管理器配置文件
// 从 macOS AeroSpace 迁移而来，保留相似的快捷键和布局习惯
// 配置文件位置: ~/.config/niri/config.kdl
// ============================================================

// -------------------- 输入设备 --------------------

input {
    keyboard {
        xkb {
            // 键盘布局，默认 US QWERTY
            layout "us"
        }

        // 按键重复延迟（毫秒）
        repeat-delay 600
        // 按键重复速率（每秒字符数）
        repeat-rate 25
    }

    touchpad {
        // 启用轻触点击
        tap
        // 自然滚动（与手指方向一致）
        natural-scroll
        // 加速配置
        accel-speed 0.2
        accel-profile "adaptive"
        // 打字时禁用触摸板
        dwt
    }

    mouse {
        // 鼠标加速配置
        accel-profile "flat"
    }

    // 鼠标移入窗口时自动聚焦
    focus-follows-mouse

    // 重复切换同一工作区时，返回上一个工作区（与 AeroSpace 的 workspace-back-and-forth 一致）
    workspace-auto-back-and-forth
}

// -------------------- 输出（显示器）配置 --------------------

// 如需配置特定显示器，取消下方注释并修改
// output "eDP-1" {
//     // 分辨率和刷新率
//     mode "2560x1600@120.000"
//     // 缩放比例
//     scale 2.0
//     // 位置
//     position x=0 y=0
// }

// -------------------- 布局配置 --------------------

layout {
    // 窗口间距（与 AeroSpace 的 inner gaps 15px 一致）
    gaps 15

    // 聚焦的列居中显示策略
    // "never" - 不居中
    // "always" - 总是居中
    // "on-overflow" - 溢出时居中
    center-focused-column "never"

    // 预设列宽度（按 Mod+R 循环切换）
    preset-column-widths {
        proportion 0.33333   // 三分之一
        proportion 0.5       // 二分之一
        proportion 0.66667   // 三分之二
    }

    // 默认列宽度
    default-column-width {
        proportion 0.5
    }

    // 聚焦环（窗口聚焦指示器）
    focus-ring {
        // 关闭聚焦环，使用边框代替
        off
    }

    // 窗口边框（与 AeroSpace 的 borders 配置一致）
    border {
        // 边框宽度
        width 3

        // 活动窗口边框颜色 - Catppuccin Mocha Lavender
        active-color "#b4befe"

        // 非活动窗口边框颜色 - Catppuccin Mocha Base
        inactive-color "#1e1e2e"
    }

    // 窗口阴影
    shadow {
        on
        softness 30
        color "#00000070"
    }

    // 外边距（为 waybar 状态栏留出空间）
    struts {
        // 顶部留出空间给 waybar
        // top 40
    }
}

// -------------------- 环境变量 --------------------

environment {
    // Electron 应用使用 Wayland
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// -------------------- 启动命令 --------------------

// 启动 waybar 状态栏（对应 AeroSpace 启动 sketchybar）
spawn-at-startup "waybar"

// 启动 xwayland-satellite（支持 X11 应用）
spawn-at-startup "xwayland-satellite"

// 启动通知守护进程
spawn-at-startup "mako"

// 启动 fcitx5 输入法
spawn-at-startup "fcitx5" "-d"

// -------------------- 窗口规则 --------------------

// 所有窗口默认圆角
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// -------------------- 快捷键绑定 --------------------
// Mod 默认为 Super 键

binds {
    // ========== 应用启动 ==========

    // 打开终端（Kitty）
    Mod+Return { spawn "kitty"; }

    // 打开应用启动器（需安装 fuzzel 或 rofi）
    Mod+D { spawn "fuzzel"; }

    // 截图
    Mod+Shift+S { screenshot; }
    // 截取当前屏幕
    Print { screenshot-screen; }
    // 截取当前窗口
    Mod+Print { screenshot-window; }

    // ========== 窗口焦点切换（对应 AeroSpace 的 alt-h/j/k/l） ==========

    // 聚焦左侧列
    Mod+H { focus-column-left; }
    // 聚焦下方窗口
    Mod+J { focus-window-or-workspace-down; }
    // 聚焦上方窗口
    Mod+K { focus-window-or-workspace-up; }
    // 聚焦右侧列
    Mod+L { focus-column-right; }

    // ========== 窗口移动（对应 AeroSpace 的 alt-shift-h/j/k/l） ==========

    // 将窗口移到左侧
    Mod+Shift+H { move-column-left; }
    // 将窗口移到下方
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    // 将窗口移到上方
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    // 将窗口移到右侧
    Mod+Shift+L { move-column-right; }

    // ========== 窗口大小调整（对应 AeroSpace 的 alt-minus/equal） ==========

    // 减小窗口宽度
    Mod+Minus { set-column-width "-10%"; }
    // 增大窗口宽度
    Mod+Equal { set-column-width "+10%"; }

    // 减小窗口高度
    Mod+Shift+Minus { set-window-height "-10%"; }
    // 增大窗口高度
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ========== 窗口布局（对应 AeroSpace 的 alt-slash/comma） ==========

    // 切换预设列宽度
    Mod+R { switch-preset-column-width; }
    // 切换预设窗口高度
    Mod+Shift+R { switch-preset-window-height; }

    // 最大化列
    Mod+F { maximize-column; }
    // 全屏切换
    Mod+Shift+F { fullscreen-window; }

    // 在列内垂直/水平方向切换（类似 AeroSpace 的 layout tiles）
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // ========== 工作区切换（对应 AeroSpace 的 alt-1~9） ==========

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // ========== 移动窗口到工作区（对应 AeroSpace 的 alt-shift-1~9） ==========

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ========== 工作区导航 ==========

    // 上一个工作区
    Mod+Page_Up { focus-workspace-up; }
    // 下一个工作区
    Mod+Page_Down { focus-workspace-down; }

    // 移动工作区到其他显示器（对应 AeroSpace 的 alt-shift-tab）
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }

    // 将工作区移到左/右显示器
    Mod+Shift+Left { move-workspace-to-monitor-left; }
    Mod+Shift+Right { move-workspace-to-monitor-right; }

    // ========== 显示器焦点切换 ==========

    // 聚焦左侧显示器
    Mod+Ctrl+Left { focus-monitor-left; }
    // 聚焦右侧显示器
    Mod+Ctrl+Right { focus-monitor-right; }

    // ========== 窗口操作 ==========

    // 关闭窗口
    Mod+Q { close-window; }

    // 切换浮动/平铺模式（对应 AeroSpace service 模式的 f 键）
    Mod+V { toggle-window-floating; }

    // 在浮动窗口和平铺窗口间切换焦点
    Mod+Space { switch-focus-between-floating-and-tiling; }

    // ========== 系统操作 ==========

    // 退出 niri
    Mod+Shift+E { quit; }

    // 关闭电源按键处理（让 systemd 处理）
    // Mod+Shift+P { power-off-monitors; }

    // 锁屏
    Mod+Escape { spawn "swaylock"; }

    // ========== 鼠标滚轮绑定 ==========

    // 滚轮调整列宽
    Mod+WheelScrollDown cooldown-ms=150 { set-column-width "-10%"; }
    Mod+WheelScrollUp   cooldown-ms=150 { set-column-width "+10%"; }

    // 触摸板手势调整列宽
    Mod+TouchpadScrollDown { set-column-width "-1%"; }
    Mod+TouchpadScrollUp   { set-column-width "+1%"; }
}

// -------------------- 动画配置 --------------------

animations {
    // 工作区切换动画（弹簧模型）
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // 窗口打开动画
    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    // 窗口关闭动画
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    // 水平视图移动
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // 窗口移动动画
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // 窗口缩放动画
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // 配置通知动画
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
}
